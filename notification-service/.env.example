# Railway Variables (obligatoires pour que le service démarre utilement)
# Ne PAS forcer PORT=3000 — Railway injecte PORT automatiquement.
SERVICE_SECRET=change-me-long-random-min-32-chars
SUPABASE_URL=https://dkmbtwczuheyyxvuypml.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...votre-service-role-key...

WHATSAPP_ENABLED=true
# legacy (défaut) = worker whatsapp-web.js local ; openwa = gateway OpenWA Railway séparé
WHATSAPP_TRANSPORT=legacy
WWEBJS_AUTH_PATH=/data/.wwebjs_auth

# Requis uniquement avec WHATSAPP_TRANSPORT=openwa.
# Ne jamais versionner les vraies valeurs.
OPENWA_BASE_URL=https://votre-openwa.up.railway.app
OPENWA_API_KEY=change-me-openwa-api-key
OPENWA_SESSION_ID=change-me-openwa-session-id
OTP_TTL_MINUTES=15
ORDER_SESSION_DAYS=7

# Queue Railway : un seul consommateur par service WhatsApp.
NOTIFICATION_QUEUE_POLL_MS=3000
NOTIFICATION_QUEUE_LEASE_SECONDS=180
APP_PUBLIC_URL=https://votre-frontend.vercel.app

# Local seulement :
# PORT=3099
# WWEBJS_AUTH_PATH=./.wwebjs_auth
