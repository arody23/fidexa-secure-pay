# Supabase (frontend)

VITE_SUPABASE_URL=

VITE_SUPABASE_PUBLISHABLE_KEY=



# Postgres direct — pour migrations CLI Supabase

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres



# MoneyFusion (legacy — désactivé)

VITE_MONEYFUSION_ENABLED=false

# PayPal (legacy — désactivé)

VITE_PAYPAL_ENABLED=false

VITE_PAYPAL_CLIENT_ID=

VITE_PAYPAL_ENV=sandbox

# KPay Mobile Money (secrets API → Supabase Edge Functions uniquement)

VITE_KPAY_ENABLED=true

VITE_KPAY_PAYOUT_ENABLED=true
